    <!-- معالج الإعداد -->
    <string name="wizard_step">الخطوة %1$d من %2$d</string>
    <string name="wizard_title_1">القواميس غير مضمّنة في التطبيق</string>
    <string name="wizard_body_1">لكل قاموس رخصته الخاصة، لذلك لا يتضمن ملف APK أي مواد قاموسية. النسخة العامة تحمل الكود والتعليمات فقط. تُجهَّز كل القواميس محليًا على هذا الجهاز من ملفات تنزّلها بنفسك.</string>
    <string name="wizard_title_2">ما الذي ستحتاجه</string>
    <string name="wizard_body_2">الأرشيف الرسمي لقاعدة الصرف من CAMeL، وهو calima-msa-r13 بحجم 40 ميغابايت ورخصة GPL-2. تُحوَّل القاعدة على هذا الجهاز بزر واحد في معالج الاستيراد. أما معجم الرياض وHans Wehr وKaikki فتُبنى بأدوات من المستودع. وبدون الحزم يعمل التطبيق لكنه لا يعرض المواد.</string>
    <string name="wizard_title_3">كيف يعمل</string>
    <string name="wizard_body_3">حدّد كلمة عربية في أي تطبيق واختر «القاموس» من قائمة التحديد. ستفتح نافذة فيها مادة إلى ثلاث مواد. لكل معنى زر «أضف إلى Anki»؛ تُضاف البطاقة إلى الرزمة التي تختارها. الزر العائم اختياري وهو متوقف افتراضيًا.</string>
    <string name="wizard_back">رجوع</string>
    <string name="wizard_next">التالي</string>
    <string name="wizard_done">تم</string>

    <!-- استيراد الحزم -->
    <string name="import_title">استيراد الحزم</string>
    <string name="import_intro">تُحفظ الحزم على هذا الجهاز فقط. لا يحمّل التطبيق أي مواد قاموسية من الشبكة.</string>
    <string name="import_camel">صارف CAMeL (calima-msa-r13)</string>
    <string name="import_camel_sub">تحليل الصيغ والجذور. يُبنى على هذا الجهاز من الأرشيف الرسمي لـ CAMeL-Lab.</string>
    <string name="import_ksaa">معجم الرياض للغة العربية (KSAA)</string>
    <string name="import_ksaa_sub">القاموس العربي العربي الرئيسي. يُبنى على هذا الجهاز؛ ولا يُعاد نشر نصه.</string>
    <string name="import_kaikki">Kaikki (Wiktionary)</string>
    <string name="import_kaikki_sub">شروح إنجليزية. رخصة CC BY-SA 4.0. يُبنى بأداة tools/build_kaikki_index.py.</string>
    <string name="import_hw">Hans Wehr</string>
    <string name="import_hw_sub">معانٍ إنجليزية. يُبنى بأداة tools/build_hw_pack.py. لا يُعاد نشر الملف.</string>
    <string name="import_pick">اختيار ملف…</string>
    <string name="size_mb">%1$.1f ميغابايت</string>
    <string name="size_kb">%1$d كيلوبايت</string>

    <!-- إعداد Anki -->
    <string name="anki_title">إعداد Anki</string>
    <string name="anki_intro">تنتقل البطاقات من النافذة إلى AnkiDroid على هذا الهاتف، أو إلى Anki على الحاسوب عبر ملف haqomu.apkg.</string>
    <string name="anki_step2">افتح الملف أو شاركه مع AnkiDroid. تظهر رزمة Haqomu ونوع الملاحظة تلقائيًا.</string>
    <string name="anki_step3">على الحاسوب افتح الملف نفسه: يستورد Anki Desktop الرزمة نفسها ونوع الملاحظة نفسه.</string>
    <string name="anki_step4">ستذهب بطاقات النافذة إلى الرزمة المحددة بالأسفل. يمكنك تغيير الرزمة الهدف في أي وقت.</string>
    <string name="anki_deck_label">الرزمة الهدف</string>
    <string name="anki_deck_hint">الرزمة التي يضيف إليها التطبيق البطاقات. الافتراضي Haqomu.</string>
    <string name="anki_connect_note">لإضافة البطاقات على الحاسوب يمكن تفعيل AnkiConnect في إعدادات Anki Desktop. هذا اختياري: التصدير عبر .apkg يعمل بدونه.</string>

