    <!-- عن التطبيق -->
    <string name="about_title">عن التطبيق</string>
    <string name="about_version">الإصدار %1$s · com.bernkastel5.haqomu</string>
    <string name="about_tagline">عدسة قاموسية للنص العربي. حدّد كلمة في أي تطبيق واختر «القاموس» واحصل على المعنى. بلا خادم، بلا حسابات، بلا إعلانات.</string>
    <string name="about_code_title">الكود المصدري</string>
    <string name="about_code_body">github.com/bernkastel5/Haqomu. ينشر الكود برخصة GPL-3.0.</string>
    <string name="about_data_title">البيانات والإحالات</string>
    <string name="about_data_kaikki">Kaikki (Wiktionary)، شروح إنجليزية: CC BY-SA 4.0</string>
    <string name="about_data_camel">CAMeL Tools وقاعدة calima-msa-r13: GPL-2</string>
    <string name="about_data_gloss">ArabGlossBERT (SinaLab): CC BY-SA 4.0</string>
    <string name="about_data_ksaa">معجم الرياض للغة العربية، مجمع الملك سلمان العالمي للغة العربية. لا يُعاد نشر نص القاموس.</string>
    <string name="about_data_hw">Hans Wehr، A Dictionary of Modern Written Arabic. © Harrassowitz Verlag. لا يُعاد نشر نص القاموس.</string>
    <string name="about_data_analyzer">تحليل الصيغ منقول من camel-tools: GPL-3.</string>
    <string name="about_privacy_title">الخصوصية</string>
    <string name="about_privacy_network">لا يرسل التطبيق أي شيء إلى الشبكة. الاستثناءات الوحيدة: تنزيل النموذج الاختياري بزرك (يصل مع النموذج) وبناء حزمة الصرف من أرشيف CAMeL على هذا الجهاز.</string>
    <string name="about_privacy_screen">يُستخدم نص الشاشة لتحديد الجملة المحيطة بالكلمة المحددة فقط، ولا يُحفظ في أي مكان.</string>
    <string name="about_privacy_history">لا يحتفظ التطبيق بسجل استعلامات.</string>

